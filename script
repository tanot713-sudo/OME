//   3) Link จะได้ประมาณ https://drive.google.com/file/d/XXXX/view
//   4) เอา XXXX มาใส่ใน LOGO_DRIVE_ID ด้านล่าง
const LOGO_DRIVE_ID = '1UiYHVecqMs5DaoIT3z-aIOjweIJ8FP5q'; // ← File ID โลโก้ (สำรอง ไม่ได้ใช้แล้ว)
// ฝัง logo เป็น base64 ตรงนี้เลย เพื่อไม่ต้องพึ่ง Google Drive sharing/permission
// (เคยมีปัญหาโหลดไม่ขึ้นเพราะ thumbnail URL ของ Drive ใช้ไม่ได้/ไม่มีสิทธิ์)
const LOGO_SRC = "data:image/png;base64,";

function applyLogo(src) {
  // Header brandmark
  const hdr = document.getElementById('headerBrandmark');
  const hdrFallback = document.getElementById('headerLogoFallback');
  // Auth logo
  const authBox = document.getElementById('authLogoBox');
  const authFallback = document.getElementById('authLogoFallback');

  if (src && src.trim()) {
    // Header
    if (hdrFallback) hdrFallback.style.display = 'none';
    const hImg = document.createElement('img');
    hImg.src = src; hImg.alt = 'AMR Asia';
    hImg.style.cssText = 'height:var(--logo-h);width:auto;max-width:160px;display:block;object-fit:contain';
    hImg.onerror = () => { hImg.remove(); if(hdrFallback) hdrFallback.style.display = ''; };
    hdr.appendChild(hImg);

    // Auth
    if (authFallback) authFallback.style.display = 'none';
    const aImg = document.createElement('img');
    aImg.src = src; aImg.alt = 'AMR Asia';
    aImg.style.cssText = 'height:38px;width:auto;max-width:116px;display:block;object-fit:contain';
    aImg.onerror = () => { aImg.remove(); if(authFallback) authFallback.style.display = ''; };
    authBox.appendChild(aImg);
