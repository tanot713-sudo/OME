// โลก้โหลดผ่าน GitHub CDN (jsDelivr) — ไฟล์ logo.png อยู่ใน repo tanot713-sudo/OME
const LOGO_SRC = 'https://cdn.jsdelivr.net/gh/tanot713-sudo/OME@master/logo.png';

function applyLogo(src) {
