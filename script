function fillSavedFilters(){
  const fp=$('#savedFProject'); if(!fp) return;
  const role=AUTH.user?.role||'', userProj=AUTH.user?.project||'';
  const isRestricted=role==='leader'||role==='inspector';
  if(isRestricted&&userProj){
    const userProjs=userProj.split(',').map(p=>p.trim()).filter(Boolean);
    const cur=fp.value;
    fp.innerHTML=userProjs.map(p=>`<option value="${escAttr(p)}">${esc(p)}</option>`).join('');
    if(userProjs.includes(cur)) fp.value=cur; else if(userProjs.length===1) fp.value=userProjs[0];
  } else {
    const projects=uniq(entries.map(e=>e.project)).filter(Boolean).sort((a,b)=>a.localeCompare(b,'th'));
    const prev=fp.value;
    fp.innerHTML='<option value="">ทุกโครงการ</option>'+projects.map(p=>`<option value="${escAttr(p)}">${esc(p)}</option>`).join('');
    if(projects.includes(prev)) fp.value=prev;
  }
  const fillDep=(el,src,key,defLabel)=>{
    if(!el) return;
    const prev=el.value;
    const vals=uniq(src.map(e=>e[key])).filter(Boolean).sort((a,b)=>a.localeCompare(b,'th'));
    el.innerHTML=`<option value="">${defLabel}</option>`+vals.map(v=>`<option value="${escAttr(v)}">${esc(v)}</option>`).join('');
    if(vals.includes(prev)) el.value=prev;
  };
  let sc=entries; if(fp.value) sc=sc.filter(e=>e.project===fp.value);
  fillDep($('#savedFSystem'),sc,'system','ทุกระบบ');
  let sc2=sc; if($('#savedFSystem')&&$('#savedFSystem').value) sc2=sc2.filter(e=>e.system===$('#savedFSystem').value);
  fillDep($('#savedFLoc'),sc2,'locName','ทุกสถานที่');
  let sc3=sc2; if($('#savedFLoc')&&$('#savedFLoc').value) sc3=sc3.filter(e=>e.locName===$('#savedFLoc').value);
  fillDep($('#savedFSub'),sc3,'subName','ทุกสถานที่ย่อย');
  let sc4=sc3; if($('#savedFSub')&&$('#savedFSub').value) sc4=sc4.filter(e=>e.subName===$('#savedFSub').value);
  fillDep($('#savedFEquip'),sc4,'equipment','ทุกอุปกรณ์');
}

