const TEMPLATE_CONFIG = {
  FILE_NAME: 'AMR_report_template_FIXED.docx',
  FILE_ID:   '1EZyibVq33y3Xzt82bXtD5DUKp_zIciDf'
};

function applyTemplateSelection(name, fileId){
  const nameEl = document.getElementById('tmplFileName');
  const idEl   = document.getElementById('tmplFileId');
  const inp    = document.getElementById('wgTemplateId');
  if(nameEl) nameEl.textContent = name;
  if(idEl)   idEl.textContent   = fileId;
  if(inp)    inp.value          = fileId;
}
applyTemplateSelection(TEMPLATE_CONFIG.FILE_NAME, TEMPLATE_CONFIG.FILE_ID);

/* ─── Template picker — เลือก/เพิ่ม Word/PDF template จากเว็บ ─────────────── */
async function loadReportTemplates(){
  const sel=$('#tmplPicker'); if(!sel) return;
  const r=await api('listReportTemplates',{});
  const saved=(r&&r.ok&&Array.isArray(r.templates))?r.templates:[];
  const opts=[{name:TEMPLATE_CONFIG.FILE_NAME+' (ค่าตั้งต้น)',fileId:TEMPLATE_CONFIG.FILE_ID}].concat(saved);
  sel.innerHTML=opts.map(t=>`<option value="${escAttr(t.fileId)}">${esc(t.name)}</option>`).join('');
  sel.onchange=()=>{
    const chosen=opts.find(t=>t.fileId===sel.value);
    if(chosen) applyTemplateSelection(chosen.name.replace(' (ค่าตั้งต้น)',''), chosen.fileId);
  };
}
