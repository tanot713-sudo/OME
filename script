function fillMasterFilters(){
  const fp=$('#masterFProject'); if(!fp) return;
  const projects=uniq(master.map(m=>m.project)).filter(Boolean).sort((a,b)=>a.localeCompare(b,'th'));
  const prev=fp.value;
  fp.innerHTML='<option value="">ทุกโครงการ</option>'+projects.map(p=>`<option value="${escAttr(p)}">${esc(p)}</option>`).join('');
  if(projects.includes(prev)) fp.value=prev;
  const fillDep=(el,src,key,defLabel)=>{
    if(!el) return;
    const prevV=el.value;
    const vals=uniq(src.map(m=>m[key])).filter(Boolean).sort((a,b)=>a.localeCompare(b,'th'));
    el.innerHTML=`<option value="">${defLabel}</option>`+vals.map(v=>`<option value="${escAttr(v)}">${esc(v)}</option>`).join('');
    if(vals.includes(prevV)) el.value=prevV;
  };
  let sc=master; if(fp.value) sc=sc.filter(m=>m.project===fp.value);
  fillDep($('#masterFSystem'),sc,'system','ทุกระบบ');
  let sc2=sc; if($('#masterFSystem')&&$('#masterFSystem').value) sc2=sc2.filter(m=>m.system===$('#masterFSystem').value);
  fillDep($('#masterFLoc'),sc2,'locName','ทุกสถานที่');
  let sc3=sc2; if($('#masterFLoc')&&$('#masterFLoc').value) sc3=sc3.filter(m=>m.locName===$('#masterFLoc').value);
  fillDep($('#masterFSub'),sc3,'subName','ทุกสถานที่ย่อย');
  let sc4=sc3; if($('#masterFSub')&&$('#masterFSub').value) sc4=sc4.filter(m=>m.subName===$('#masterFSub').value);
  fillDep($('#masterFEquip'),sc4,'equipment','ทุกอุปกรณ์');
}

