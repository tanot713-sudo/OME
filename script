/* ─── WORD TEMPLATE GENERATION (browser-side, mirrors Colab) ── */
async function fetchImageBuffer(url){if(!url)return null;try{const m=String(url).match(/[-\w]{25,}/);if(m)url=`https://drive.google.com/thumbnail?id=${m[0]}&sz=w800`;const r=await fetch(url);if(!r.ok)return null;return await r.arrayBuffer();}catch(e){return null;}}

function setWgProgress(pct,msg){const bar=$('#wgBar'),status=$('#wgStatus'),box=$('#wgProgress');if(box)box.classList.add('show');if(bar)bar.style.width=pct+'%';if(status)status.innerHTML=msg;}

async function generateWordTemplate(){
  if(typeof docx==='undefined'){toast('ไลบรารี Word ยังโหลดไม่เสร็จ ลองใหม่',false);return;}
  if(!entries.length){toast('ยังไม่มีข้อมูล',false);return;}
  const {Document,Packer,Paragraph,TextRun,HeadingLevel,Table,TableRow,TableCell,ImageRun,AlignmentType,BorderStyle,WidthType,PageNumber,Header,Footer,TableOfContents,TabStopType,TabStopPosition}=docx;
  const groupBy=$('#wgGroupBy').value;
  const fieldKey={project:'project',system:'system',location:'locName'}[groupBy];
  const groupLabel={project:'โครงการ',system:'ระบบ',location:'สถานที่'}[groupBy];
  const reportName=$('#wgReportName').value.trim()||'รายงานอุปกรณ์';
  const contract=$('#wgContract').value.trim();
  const contractNo=$('#wgContractNo').value.trim()||'-';
  const contractDate=$('#wgDate').value.trim()||'-';
  const client=$('#wgClient').value.trim();
  const btn=$('#wgGenerate');btn.disabled=true;
  setWgProgress(5,'กำลังเตรียมข้อมูล...');

  const FONT='TH Sarabun New',RED='E2231A',DARK='1A232E',GREY='5B6573';
  const T=(t,o={})=>new TextRun({text:t,font:FONT,size:(o.size||28),bold:o.bold||false,color:o.color||'000000'});
  const P=(runs,o={})=>new Paragraph({children:Array.isArray(runs)?runs:[runs],alignment:o.align,spacing:o.spacing,heading:o.heading});

  /* Logo — รองรับทั้ง base64 และ URL */
  let logoBuf=null;
  if(LOGO_SRC&&LOGO_SRC.trim()){
    try{
      if(LOGO_SRC.startsWith('data:')){
        // base64 string
        const b64=LOGO_SRC.split(',')[1];
        if(b64){const bin=atob(b64);const len=bin.length;const buf=new Uint8Array(len);for(let i=0;i<len;i++)buf[i]=bin.charCodeAt(i);logoBuf=buf.buffer;}
      } else {
        // URL — fetch เป็น ArrayBuffer
        setWgProgress(10,'กำลังโหลดโลโก้...');
        logoBuf = await fetchImageBuffer(LOGO_SRC);
      }
    }catch(e){logoBuf=null;}
  }

  /* Cover */
  setWgProgress(15,'กำลังสร้างหน้าปก...');
  const coverKids=[];
  if(logoBuf)coverKids.push(new Paragraph({alignment:AlignmentType.CENTER,children:[new ImageRun({data:logoBuf,transformation:{width:150,height:93}})]}));
  coverKids.push(P(T('บริษัท เอเอ็มอาร์ เอเซีย จำกัด (มหาชน)',{size:36,bold:true,color:RED}),{align:AlignmentType.CENTER}));
  coverKids.push(P(T('AMR Asia Public Company Limited',{size:28,bold:true,color:DARK}),{align:AlignmentType.CENTER}));
  for(let i=0;i<3;i++)coverKids.push(new Paragraph({}));
  coverKids.push(P(T(reportName,{size:40,bold:true}),{align:AlignmentType.CENTER}));
  if(contract)coverKids.push(P(T(contract,{size:36,bold:true}),{align:AlignmentType.CENTER}));
  coverKids.push(P(T(`สัญญาเลขที่ ${contractNo}  ลงวันที่ ${contractDate}`,{size:32}),{align:AlignmentType.CENTER}));
  for(let i=0;i<2;i++)coverKids.push(new Paragraph({}));
  coverKids.push(P(T('นำส่ง',{size:32}),{align:AlignmentType.RIGHT}));
  for(let i=0;i<6;i++)coverKids.push(new Paragraph({}));
  if(client)coverKids.push(P(T(client,{size:36,bold:true,color:DARK}),{align:AlignmentType.CENTER}));

  const tocKids=[P(T('สารบัญ',{size:44,bold:true,color:DARK}),{align:AlignmentType.CENTER}),new TableOfContents('สารบัญ',{hyperlink:true,headingStyleRange:'1-3'})];

  /* Body */
  setWgProgress(25,'กำลังจัดกลุ่มข้อมูล...');
  const groups={};entries.forEach(e=>{const k=e[fieldKey]||'(ไม่ระบุ)';(groups[k]=groups[k]||[]).push(e);});
  const bodyKids=[P(T(groupLabel,{size:36,bold:true,color:RED}),{heading:HeadingLevel.HEADING_1})];
  const groupNames=Object.keys(groups).sort();
  let imgDone=0,totalImgs=0;
  entries.forEach(e=>{if(e.thumbMain||e.imgMain)totalImgs++;if(e.thumbSticker||e.imgSticker)totalImgs++;});

  const noBorders=()=>{const n={style:BorderStyle.NONE,size:0,color:'FFFFFF'};return{top:n,bottom:n,left:n,right:n,insideHorizontal:n,insideVertical:n};};

  for(let gi=0;gi<groupNames.length;gi++){
    const gname=groupNames[gi];const items=groups[gname];
    bodyKids.push(P(T(`${gi+1}. ${gname}`,{size:30,bold:true,color:DARK}),{heading:HeadingLevel.HEADING_2}));
    bodyKids.push(P(T(`จำนวน ${items.length} รายการ`,{size:26,color:GREY})));
    for(let i=0;i<items.length;i++){
      const e=items[i];
      bodyKids.push(P(T(`${i+1}. ${e.equipment||'(ไม่ระบุอุปกรณ์)'}`,{size:28,bold:true,color:DARK}),{heading:HeadingLevel.HEADING_3}));
      const bm=[e.brand?'ยี่ห้อ '+e.brand:'',e.model?'รุ่น '+e.model:''].filter(Boolean).join('  ');if(bm)bodyKids.push(P(T(bm,{size:28})));
      const meta=[e.serial?'Serial: '+e.serial:'',e.asset?'รหัส: '+e.asset:''].filter(Boolean).join('   ');if(meta)bodyKids.push(P(T(meta,{size:24,color:GREY})));
      const loc=[e.locName,e.subName].filter(Boolean).join(' ');if(loc)bodyKids.push(P(T(loc,{size:26,color:GREY})));
      const urls=[e.thumbMain||e.imgMain,e.thumbSticker||e.imgSticker].filter(Boolean);
      if(urls.length){
        imgDone++;
        setWgProgress(25+Math.round(imgDone/Math.max(totalImgs,1)*55),`กำลังโหลดรูปภาพ... ${imgDone}/${totalImgs}`);
        const bufs=[];for(const u of urls){const b=await fetchImageBuffer(u);if(b)bufs.push(b);}
        if(bufs.length){const cells=bufs.map(b=>new TableCell({borders:noBorders(),children:[new Paragraph({alignment:AlignmentType.CENTER,children:[new ImageRun({data:b,transformation:{width:230,height:170}})]})]}));while(cells.length<2)cells.push(new TableCell({borders:noBorders(),children:[new Paragraph({})]}));bodyKids.push(new Table({width:{size:100,type:WidthType.PERCENTAGE},rows:[new TableRow({children:cells})]}));}
      }
      if(e.note)bodyKids.push(P(T(`หมายเหตุ: ${e.note}`,{size:24,color:GREY})));
      bodyKids.push(new Paragraph({}));
    }
  }

  /* Header / Footer */
  setWgProgress(85,'กำลังสร้างส่วนหัว-ท้าย...');
  const hdrLeft=new TableCell({borders:noBorders(),width:{size:25,type:WidthType.PERCENTAGE},children:[logoBuf?new Paragraph({children:[new ImageRun({data:logoBuf,transformation:{width:90,height:56}})]}):P(T('AMR ASIA',{bold:true,color:RED}))]});
  const hdrRight=new TableCell({borders:noBorders(),width:{size:75,type:WidthType.PERCENTAGE},children:[P(T(contract||reportName,{size:24}),{align:AlignmentType.RIGHT}),P(T(`สัญญาเลขที่ ${contractNo}`,{size:24}),{align:AlignmentType.RIGHT})]});
  const header=new Header({children:[new Table({width:{size:100,type:WidthType.PERCENTAGE},borders:noBorders(),rows:[new TableRow({children:[hdrLeft,hdrRight]})]})]});
  const footer=new Footer({children:[new Paragraph({tabStops:[{type:TabStopType.RIGHT,position:TabStopPosition.MAX}],children:[T(`ชื่อรายงาน : ${reportName}`,{size:22}),new TextRun({text:'\t',font:FONT}),new TextRun({children:['หน้าที่ ',PageNumber.CURRENT,' of ',PageNumber.TOTAL_PAGES],font:FONT,size:22})]})]});

  setWgProgress(92,'กำลังบีบอัดไฟล์...');
  const doc=new Document({styles:{default:{document:{run:{font:FONT}}}},sections:[
    {properties:{},children:[...coverKids,new Paragraph({pageBreakBefore:true}),...tocKids]},
    {properties:{page:{margin:{top:1400,bottom:1100,left:1130,right:1130}}},headers:{default:header},footers:{default:footer},children:bodyKids}
  ]});
  const blob=await Packer.toBlob(doc);
  const fn=`รายงานอุปกรณ์_${groupLabel}_${fileStamp(Date.now())}.docx`;
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=fn;a.click();URL.revokeObjectURL(a.href);
