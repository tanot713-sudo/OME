/* ══════════════════════════════════════════════════════════
   CORE APP
══════════════════════════════════════════════════════════ */
const API_URL = 'https://script.google.com/macros/s/AKfycbzjzlcLO0brmnOaD5UNuqi9MuKs0x__p7G9DdQZ2dVZ7MEm6_t8nP4FquwUFhCMStUeNQ/exec';
const PDPA_VERSION = '1.0';
const ACT = {
  login:'login', verifyToken:'verifyToken', pdpaStatus:'getPdpaStatus', pdpaAccept:'acceptPdpa',
  createRecord:'createRecord', listRecords:'listRecords', deleteRecord:'deleteRecord',
  createUser:'createUser', bulkCreateUsers:'bulkCreateUsers', listUsers:'listUsers',
  saveMaster:'saveMaster', listMaster:'listMaster', getProgress:'getProgress'
};
const TOKEN_KEY='amr_token', USER_KEY='amr_user';
let AUTH = { token:null, user:null };
let _clientIP = '';

const $=s=>document.querySelector(s);
const uid=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,7);
const uniq=a=>[...new Set(a.filter(v=>v!==''&&v!=null))];
const esc=s=>String(s==null?'':s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const escAttr=s=>String(s==null?'':s).replace(/"/g,'&quot;');
const pad=n=>String(n).padStart(2,'0');
const fmtDate=(ts,t)=>{const d=new Date(ts);let s=`${pad(d.getDate())}/${pad(d.getMonth()+1)}/${d.getFullYear()+543}`;if(t)s+=` ${pad(d.getHours())}:${pad(d.getMinutes())} น.`;return s;};
const fileStamp=ts=>{const d=new Date(ts);return `${d.getFullYear()}${pad(d.getMonth()+1)}${pad(d.getDate())}_${pad(d.getHours())}${pad(d.getMinutes())}`;};

async function getClientIP(){if(_clientIP)return _clientIP;try{const r=await fetch('https://api.ipify.org?format=json');const j=await r.json();_clientIP=j.ip||'';}catch(e){_clientIP='';}return _clientIP;}
async function api(action,payload={}){
  const ctx={device:navigator.platform||'',browser:navigator.userAgent||'',ip:await getClientIP(),ts:new Date().toISOString()};
  const body=JSON.stringify({action,...payload,token:AUTH.token,ctx});
  let res;
  try{res=await fetch(API_URL,{method:'POST',headers:{'Content-Type':'text/plain;charset=utf-8'},redirect:'follow',body});}
  catch(e){return{ok:false,error:'NETWORK',message:'เชื่อมต่อเซิร์ฟเวอร์ไม่ได้'};}
  let data;
  try{data=await res.json();}catch(e){return{ok:false,error:'BAD_RESPONSE',message:'รูปแบบข้อมูลตอบกลับไม่ถูกต้อง'};}
  if(data&&data.error==='UNAUTHORIZED')doLogout();
  return data;
}

function saveSession(t,u){AUTH.token=t;AUTH.user=u;try{sessionStorage.setItem(TOKEN_KEY,t);sessionStorage.setItem(USER_KEY,JSON.stringify(u));}catch(e){}}
function loadSession(){try{const t=sessionStorage.getItem(TOKEN_KEY),u=sessionStorage.getItem(USER_KEY);if(t&&u){AUTH.token=t;AUTH.user=JSON.parse(u);return true;}}catch(e){}return false;}
function clearSession(){AUTH={token:null,user:null};try{sessionStorage.removeItem(TOKEN_KEY);sessionStorage.removeItem(USER_KEY);}catch(e){}}

let toastTimer;
function toast(msg,ok=true){const t=$('#toast');$('#toastMsg').textContent=msg;t.querySelector('.tdot').style.background=ok?'var(--ok)':'var(--danger)';t.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.classList.remove('show'),2800);}

/* ─── AUTH ──────────────────────────────────────────────── */
function showGate(){$('#authGate').classList.remove('hidden');}
function hideGate(){$('#authGate').classList.add('hidden');}
function authError(msg){const e=$('#authErr');e.textContent=msg;e.classList.add('show');}
function clearAuthError(){$('#authErr').classList.remove('show');}

async function doLogin(){
  const username=$('#authUser').value.trim(), password=$('#authPass').value;
  clearAuthError();
  if(!username||!password){authError('กรุณากรอกชื่อผู้ใช้และรหัสผ่าน');return;}
  const btn=$('#authBtn');btn.disabled=true;btn.textContent='กำลังเข้าสู่ระบบ...';
  const r=await api(ACT.login,{username,password});
  btn.disabled=false;btn.textContent='เข้าสู่ระบบ';
  if(!r||!r.ok){authError((r&&r.message)||'ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง');return;}
  saveSession(r.token,r.user||{username});
  $('#authPass').value='';
  paintUser();hideGate();
  await afterLogin();
}
function doLogout(){clearSession();$('#userChip').style.display='none';$('#authUser').value='';$('#authPass').value='';hidePdpa();showGate();}
async function afterLogin(){
  await checkPdpa();await loadAll();await loadMasterFromBackend();
  await Promise.all([
    loadRecords(),loadProgress(),loadSurvey(),loadTargets(),
    ...(AUTH.user?.role==='admin' ? [loadPagePerms()] : [])
  ]);
}

function paintUser(){
  const u=AUTH.user;if(!u){$('#userChip').style.display='none';return;}
  const name=u.name||u.username||'ผู้ใช้';
  $('#uName').textContent=name;
  $('#uRole').textContent=(u.role||'').toUpperCase();
  $('#uAvatar').textContent=(name.trim()[0]||'?').toUpperCase();
  $('#userChip').style.display='flex';
  applyRoleVisibility();
}
// ดูสิทธิ์หน้า/ฟีเจอร์จาก pagePerms ที่ admin ตั้งไว้ (ได้มาตอน login) — admin เห็น/ทำได้ทุกอย่างเสมอ
function hasPagePerm(page){
  const u=AUTH.user; if(!u) return false;
  if(u.role==='admin') return true;
  return Array.isArray(u.pagePerms) && u.pagePerms.includes(page);
}
function canSeeDashboard(){return hasPagePerm('overview');}
function canSeeMaster(){return hasPagePerm('master');}
function canSeeUsers(){return (AUTH.user&&AUTH.user.role)==='admin';}
function canEdit(){return (AUTH.user&&AUTH.user.role)!=='observer';}
function canDelete(){return hasPagePerm('delete');}
function canPdf(){return hasPagePerm('pdfReport');}

function applyRoleVisibility(){
  const dash=canSeeDashboard(),master=canSeeMaster(),users=canSeeUsers(),edit=canEdit();
  if($('#tabDash'))$('#tabDash').style.display=dash?'':'none';
  if($('#tabMaster'))$('#tabMaster').style.display=master?'':'none';
  if($('#tabUsers'))$('#tabUsers').style.display=users?'':'none';
  if($('#tabAdd'))$('#tabAdd').style.display=(edit&&hasPagePerm('add'))?'':'none';
  document.querySelectorAll('.tab[data-tab="saved"]').forEach(t=>t.style.display=hasPagePerm('records')?'':'none');
  document.querySelectorAll('.tab[data-tab="survey"]').forEach(t=>t.style.display=hasPagePerm('survey')?'':'none');
  document.querySelectorAll('.tab[data-tab="import"]').forEach(t=>t.style.display=hasPagePerm('import')?'':'none');
  document.body.classList.toggle('readonly',!edit);
  document.body.classList.toggle('is-admin',(AUTH.user&&AUTH.user.role)==='admin');
  document.body.classList.toggle('can-pdf',canPdf());
  if(users)loadUsers();
  renderSaved();
  if(master)renderMaster();
}

/* ─── PAGE PERMISSIONS (admin) ──────────────────────────────── */
const PAGE_LABELS={overview:'ภาพรวม',add:'เพิ่มรายการ',records:'รายการที่บันทึก',survey:'สำรวจภาคสนาม',import:'Import/Export',master:'จัดการข้อมูลหลัก',users:'จัดการผู้ใช้',pdfReport:'ปุ่มสร้างรายงาน PDF',delete:'ปุ่มลบรายการ'};
let _pagePerms={};
function renderPagePermUI(){
  const box=$('#pagePermContainer'); if(!box) return;
  const roles=['manager','leader','inspector','observer'];
  const pages=['overview','add','records','survey','import','master','users','pdfReport','delete'];
  box.innerHTML=`<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:13px">
    <thead><tr><th style="padding:8px 12px;text-align:left">หน้า/ฟีเจอร์</th>${roles.map(r=>`<th style="padding:8px 12px;text-align:center"><span class="role-badge role-${r}">${r}</span></th>`).join('')}</tr></thead>
    <tbody>${pages.map(pg=>`<tr><td style="padding:7px 12px;border-top:1px solid var(--line-soft)">${PAGE_LABELS[pg]||pg}</td>${roles.map(role=>{
      const checked=(_pagePerms[role]||[]).includes(pg);
      return `<td style="text-align:center;border-top:1px solid var(--line-soft)"><input type="checkbox" class="perm-chk" data-role="${role}" data-page="${pg}" ${checked?'checked':''}></td>`;
    }).join('')}</tr>`).join('')}</tbody></table></div>
    <div style="margin-top:14px;display:flex;justify-content:flex-end"><button class="btn btn-primary" id="savePagePermsBtn">💾 บันทึกสิทธิ์การเข้าถึง</button></div>`;
  $('#savePagePermsBtn').addEventListener('click',savePagePerms);
}
async function loadPagePerms(){
  const r=await api('getPagePerms',{});
  if(r&&r.ok){ _pagePerms=r.perms||{}; renderPagePermUI(); }
}
async function savePagePerms(){
  const perms={};
  document.querySelectorAll('.perm-chk').forEach(chk=>{
    const role=chk.dataset.role,pg=chk.dataset.page;
    if(!perms[role])perms[role]=[];
    if(chk.checked)perms[role].push(pg);
  });
  const btn=$('#savePagePermsBtn'); if(btn){btn.disabled=true;btn.textContent='กำลังบันทึก…';}
  const r=await api('setPagePerms',{perms});
  if(btn){btn.disabled=false;btn.textContent='💾 บันทึกสิทธิ์การเข้าถึง';}
  if(r&&r.ok){
    _pagePerms=perms;
    toast('บันทึกสิทธิ์แล้ว',true);
  } else toast((r&&r.message)||'บันทึกสิทธิ์ไม่สำเร็จ',false);
}

/* ─── PDPA ──────────────────────────────────────────────── */
function showPdpa(){$('#pdpaBanner').classList.add('show');}
function hidePdpa(){$('#pdpaBanner').classList.remove('show');}
async function checkPdpa(){const key='pdpa_'+(AUTH.user?.username||'')+'_'+PDPA_VERSION;if(localStorage.getItem(key)==='1'){hidePdpa();return;}const r=await api(ACT.pdpaStatus,{version:PDPA_VERSION});if(r&&r.ok&&r.accepted){localStorage.setItem(key,'1');hidePdpa();return;}setTimeout(showPdpa,500);}
async function acceptPdpa(){const btn=$('#pdpaAccept');btn.disabled=true;btn.textContent='กำลังบันทึก...';const r=await api(ACT.pdpaAccept,{version:PDPA_VERSION});btn.disabled=false;btn.textContent='ยินยอม';const key='pdpa_'+(AUTH.user?.username||'')+'_'+PDPA_VERSION;localStorage.setItem(key,'1');hidePdpa();toast((r&&r.ok)?'บันทึกความยินยอมแล้ว':'บันทึกความยินยอมในเครื่องแล้ว',true);}

/* ─── TABS ──────────────────────────────────────────────── */
document.querySelectorAll('.tab').forEach(t=>t.addEventListener('click',()=>{
  document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));
  document.querySelectorAll('.panel').forEach(x=>x.classList.remove('active'));
  t.classList.add('active');$('#panel-'+t.dataset.tab).classList.add('active');
}));
function goTab(n){document.querySelector(`.tab[data-tab="${n}"]`).click();}

/* ─── MASTER / COMBO ────────────────────────────────────── */
const MASTER_KEY='master';
const LEVELS=['project','system','typeloc','loc','sub','equip','serial'];
const PROP={project:'project',system:'system',typeloc:'typeLocation',loc:'locName',sub:'subName',equip:'equipment',serial:'serial'};
const LABEL={project:'โครงการ',system:'ระบบ',typeloc:'ประเภทสถานที่',loc:'สถานที่',sub:'สถานที่ย่อย',equip:'อุปกรณ์',serial:'Serial Number'};
let master=[],entries=[],editingId=null,imgMain='',imgSticker='',img3='',img4='';
const sel={project:'',system:'',loc:'',sub:'',equip:'',serial:''};
const combos={};
const INSP_SEED=['สมชาย ใจดี','สมหญิง รักงาน'];

async function loadAll(){const m=await sGet(MASTER_KEY);if(m){try{master=JSON.parse(m);}catch(e){master=[];}}if(!master.length)master=seed();buildCombos();buildInspectorCombo();refreshDerived();renderMaster();renderSaved();updateStats();}
function seed(){return [{id:uid(),project:'รถไฟฟ้าสายสีทอง',system:'ไฟฟ้า',locName:'สถานีกรุงธนบุรี',subName:'ห้องไฟฟ้า',equipment:'ตู้ MDB',brand:'Siemens',model:'SIVACON S8',asset:'GL-EQ-001',serial:'SN-2024-00123'},{id:uid(),project:'รถไฟฟ้าสายสีทอง',system:'ไฟฟ้า',locName:'สถานีกรุงธนบุรี',subName:'ห้องไฟฟ้า',equipment:'Inverter',brand:'ABB',model:'ACS580',asset:'GL-EQ-002',serial:'SN-2024-00124'}];}

async function sGet(k){try{return localStorage.getItem(k);}catch(e){return null;}}
async function sSet(k,v){try{localStorage.setItem(k,v);}catch(e){console.warn(e);}}

function optionsFor(level){
  const idx=LEVELS.indexOf(level);let rows=master;
  const role=AUTH.user?.role||'';const userProjs=(AUTH.user?.project||'').split(',').map(p=>p.trim()).filter(Boolean);
  if((role==='leader'||role==='inspector')&&userProjs.length>0)rows=rows.filter(r=>userProjs.includes(r.project));
  for(let i=0;i<idx;i++){const lv=LEVELS[i];if(sel[lv])rows=rows.filter(r=>String(r[PROP[lv]]||'')===sel[lv]);}
  if(level==='serial'){const brand=($('#inpBrand')&&$('#inpBrand').value||'').trim();if(brand)rows=rows.filter(r=>String(r.brand||'')===brand);return uniq(rows.map(r=>String(r.serial||'')).filter(Boolean)).sort((a,b)=>a.localeCompare(b,'th'));}
  return uniq(rows.map(r=>String(r[PROP[level]]||''))).sort((a,b)=>a.localeCompare(b,'th'));
}
function buildCombos(){
  LEVELS.forEach(level=>{
    const el=document.querySelector(`.combo[data-level="${level}"]`);
    el.innerHTML=`<div class="combo-ctl"><input class="combo-input" placeholder="พิมพ์หรือเลือก${LABEL[level]}..." autocomplete="off"><span class="combo-clear">&times;</span><span class="combo-caret">▾</span></div><div class="combo-list"></div>`;
    const input=el.querySelector('.combo-input'),list=el.querySelector('.combo-list'),clear=el.querySelector('.combo-clear');
    combos[level]={el,input,list};let active=-1;
    const isDisabled=()=>el.classList.contains('disabled');
    function render(filter){let opts=optionsFor(level);const f=(filter||'').trim().toLowerCase();if(f)opts=opts.filter(o=>o.toLowerCase().includes(f));active=-1;let html=opts.map(o=>`<div class="combo-opt" data-v="${escAttr(o)}">${esc(o)}</div>`).join('');const exact=optionsFor(level).some(o=>o.toLowerCase()===f);if(f&&!exact)html+=`<div class="combo-new" data-new="${escAttr(filter.trim())}">+ ใช้ "${esc(filter.trim())}" (ใหม่)</div>`;if(!html)html=`<div class="combo-empty">ไม่มีตัวเลือก</div>`;list.innerHTML=html;list.querySelectorAll('.combo-opt').forEach(o=>o.addEventListener('mousedown',e=>{e.preventDefault();choose(level,o.dataset.v);}));const nw=list.querySelector('.combo-new');if(nw)nw.addEventListener('mousedown',e=>{e.preventDefault();choose(level,nw.dataset.new);});}
    function open(){if(isDisabled())return;el.classList.add('open');render(input.value);}
    function close(){el.classList.remove('open');}
    input.addEventListener('focus',open);input.addEventListener('click',open);
    input.addEventListener('input',()=>{el.classList.add('open');render(input.value);});
    input.addEventListener('keydown',e=>{const items=list.querySelectorAll('.combo-opt,.combo-new');if(e.key==='ArrowDown'){e.preventDefault();active=Math.min(active+1,items.length-1);}else if(e.key==='ArrowUp'){e.preventDefault();active=Math.max(active-1,0);}else if(e.key==='Enter'){e.preventDefault();if(active>=0){const it=items[active];choose(level,it.dataset.v||it.dataset.new);}else if(input.value.trim())choose(level,input.value.trim());return;}else if(e.key==='Escape'){close();return;}items.forEach((it,i)=>it.classList.toggle('active',i===active));if(active>=0)items[active].scrollIntoView({block:'nearest'});});
    input.addEventListener('blur',()=>setTimeout(()=>{close();const v=input.value.trim();if(v!==sel[level])choose(level,v);},150));
    clear.addEventListener('mousedown',e=>{e.preventDefault();choose(level,'');});
  });
  setDisabledStates();
}
function choose(level,val){val=String(val||'').trim();if(sel[level]===val){combos[level].input.value=val;combos[level].el.classList.toggle('has-val',!!val);combos[level].el.classList.remove('open');return;}sel[level]=val;combos[level].input.value=val;combos[level].el.classList.toggle('has-val',!!val);combos[level].el.classList.remove('open');const idx=LEVELS.indexOf(level);for(let i=idx+1;i<LEVELS.length;i++){const lv=LEVELS[i];sel[lv]='';if(combos[lv]){combos[lv].input.value='';combos[lv].el.classList.remove('has-val');}}setDisabledStates();updateBrandModel();}
function setDisabledStates(){LEVELS.forEach((lv,i)=>{const parentOk=i===0?true:!!sel[LEVELS[i-1]];const c=combos[lv];if(!c)return;if(parentOk){c.el.classList.remove('disabled');c.input.disabled=false;c.input.placeholder=`พิมพ์หรือเลือก${LABEL[lv]}...`;}else{c.el.classList.add('disabled');c.input.disabled=true;c.input.placeholder=`เลือก${LABEL[LEVELS[i-1]]}ก่อน`;}});if(combos.serial)refreshSerialCombo();}
function updateBrandModel(){let rows=master;['project','system','loc','sub','equip','serial'].forEach(lv=>{if(sel[lv])rows=rows.filter(r=>String(r[PROP[lv]]||'')===sel[lv]);});const brands=uniq(rows.map(r=>r.brand)),models=uniq(rows.map(r=>r.model)),assets=uniq(rows.map(r=>r.asset));setBM('bmBrand','inpBrand',brands);setBM('bmModel','inpModel',models);if(assets.length===1&&!$('#inpAsset').value)$('#inpAsset').value=assets[0];}
function refreshSerialCombo(){if(!combos.serial)return;const valid=optionsFor('serial');if(sel.serial&&!valid.includes(sel.serial)){sel.serial='';combos.serial.input.value='';combos.serial.el.classList.remove('has-val');}const ph=sel.equip?(valid.length?`เลือก Serial (${valid.length} รายการ)`:'ไม่มี Serial ใน master'):'เลือกอุปกรณ์ก่อน';if(combos.serial.input)combos.serial.input.placeholder=ph;}
function setBM(boxId,inpId,vals){const box=$('#'+boxId),inp=$('#'+inpId);if(sel.equip&&vals.length===1){box.classList.remove('empty');box.innerHTML=`<input id="${inpId}" style="display:none">`+esc(vals[0]);$('#'+inpId).value=vals[0];}else if(sel.equip){box.classList.remove('empty');box.innerHTML=`<input id="${inpId}" placeholder="กรอกเอง" value="${escAttr(vals[0]||'')}">`;}else{box.classList.add('empty');box.innerHTML=`<input id="${inpId}" style="display:none">`+(box.dataset.empty||'—');$('#'+inpId).value='';}}
function refreshDerived(){$('#masterPill').textContent=master.length;}

