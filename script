function openSurveyDialog(editId){
  editingSurveyId=editId||null; surveyImgMain=''; surveyImgSticker='';
  if($('#sdlgTitle'))$('#sdlgTitle').textContent=editId?'แก้ไขรายการสำรวจ':'เพิ่มรายการสำรวจ';
  ['sdlgProject','sdlgSystem','sdlgLoc','sdlgSub','sdlgEquip','sdlgBrand','sdlgModel','sdlgSerial','sdlgInspector','sdlgDate','sdlgNote'].forEach(id=>{const el=$('#'+id);if(el)el.value='';});
  const dm=$('#sdlgDropMain'),ds=$('#sdlgDropSticker');
  if(dm){dm.classList.remove('has-img');dm.style.backgroundImage='';}
  if(ds){ds.classList.remove('has-img');ds.style.backgroundImage='';}

  if(editId){
    const e=surveyCache.find(x=>x.id===editId);
    if(e){
      if($('#sdlgProject'))$('#sdlgProject').value=e.project||'';
      if($('#sdlgSystem'))$('#sdlgSystem').value=e.system||'';
      if($('#sdlgLoc'))$('#sdlgLoc').value=e.location||'';
      if($('#sdlgSub'))$('#sdlgSub').value=e.sublocation||'';
      if($('#sdlgEquip'))$('#sdlgEquip').value=e.equipment||'';
      if($('#sdlgBrand'))$('#sdlgBrand').value=e.brand||'';
      if($('#sdlgModel'))$('#sdlgModel').value=e.model||'';
      if($('#sdlgSerial'))$('#sdlgSerial').value=e.serial||'';
      if($('#sdlgInspector'))$('#sdlgInspector').value=e.inspector||'';
      if($('#sdlgDate'))$('#sdlgDate').value=e.surveyDate||'';
      if($('#sdlgNote'))$('#sdlgNote').value=e.note||'';
      const pvM=e.thumbMain||e.imgMain||'', pvS=e.thumbSticker||e.imgSticker||'';
      if(pvM&&dm){dm.classList.add('has-img');dm.style.backgroundImage=`url(${pvM})`;surveyImgMain=pvM;}
      if(pvS&&ds){ds.classList.add('has-img');ds.style.backgroundImage=`url(${pvS})`;surveyImgSticker=pvS;}
    }
  } else {
    try{
      const saved=localStorage.getItem(SURVEY_DRAFT_KEY);
      if(saved){
        const draft=JSON.parse(saved);
        if($('#sdlgProject'))$('#sdlgProject').value=draft.project||'';
        if($('#sdlgSystem'))$('#sdlgSystem').value=draft.system||'';
        if($('#sdlgLoc'))$('#sdlgLoc').value=draft.location||'';
        if($('#sdlgSub'))$('#sdlgSub').value=draft.sublocation||'';
        if($('#sdlgEquip'))$('#sdlgEquip').value=draft.equipment||'';
        if($('#sdlgBrand'))$('#sdlgBrand').value=draft.brand||'';
        if($('#sdlgModel'))$('#sdlgModel').value=draft.model||'';
        if($('#sdlgSerial'))$('#sdlgSerial').value=draft.serial||'';
        if($('#sdlgInspector'))$('#sdlgInspector').value=draft.inspector||'';
        if($('#sdlgDate'))$('#sdlgDate').value=draft.surveyDate||'';
        if($('#sdlgNote'))$('#sdlgNote').value=draft.note||'';
        toast('📋 กู้คืนข้อมูลที่กรอกค้างไว้แล้ว',true);
      } else {
        const d=new Date();
        if($('#sdlgDate'))$('#sdlgDate').value=`${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;
        if($('#sdlgInspector')&&AUTH.user)$('#sdlgInspector').value=AUTH.user.name||AUTH.user.username||'';
      }
    }catch(e){}
    ['sdlgProject','sdlgSystem','sdlgLoc','sdlgSub','sdlgEquip','sdlgBrand','sdlgModel','sdlgSerial','sdlgInspector','sdlgDate','sdlgNote'].forEach(id=>{
      const el=$('#'+id); if(el) el.addEventListener('input',saveSurveyDraft);
    });
  }

  const fillDL=(id,values)=>{
    let dl=document.getElementById('dl_'+id);
    if(!dl){dl=document.createElement('datalist');dl.id='dl_'+id;document.body.appendChild(dl);}
    dl.innerHTML=uniq(values).filter(Boolean).map(v=>`<option value="${escAttr(v)}">`).join('');
    const inp=$('#'+id); if(inp) inp.setAttribute('list','dl_'+id);
  };
  const updateSurveyCascade=()=>{
    let scope=master;
    const role=AUTH.user?.role||'';
    const userProjs=(AUTH.user?.project||'').split(',').map(p=>p.trim()).filter(Boolean);
    if((role==='leader'||role==='inspector')&&userProjs.length>0) scope=scope.filter(m=>userProjs.includes(m.project));
    const p=$('#sdlgProject').value; if(p) scope=scope.filter(m=>m.project===p);
    const s=$('#sdlgSystem').value; if(s) scope=scope.filter(m=>m.system===s);
    const l=$('#sdlgLoc').value; if(l) scope=scope.filter(m=>m.locName===l);
    const sl=$('#sdlgSub').value; if(sl) scope=scope.filter(m=>m.subName===sl);
    const eq=$('#sdlgEquip').value; if(eq) scope=scope.filter(m=>m.equipment===eq);
    if(!p) fillDL('sdlgProject', master.map(m=>m.project).filter(x=>userProjs.length===0||userProjs.includes(x)));
    fillDL('sdlgSystem', scope.map(m=>m.system));
    fillDL('sdlgLoc', scope.map(m=>m.locName));
    fillDL('sdlgSub', scope.map(m=>m.subName));
    fillDL('sdlgEquip', scope.map(m=>m.equipment));
    fillDL('sdlgBrand', scope.map(m=>m.brand));
    fillDL('sdlgModel', scope.map(m=>m.model));
    let inspScope=surveyCache; if(p) inspScope=inspScope.filter(e=>e.project===p);
    fillDL('sdlgInspector', uniq([...INSP_SEED,...inspScope.map(e=>e.inspector)]));
  };
  ['sdlgProject','sdlgSystem','sdlgLoc','sdlgSub','sdlgEquip'].forEach(id=>{
    const el=$('#'+id); if(el){ el.removeEventListener('input',updateSurveyCascade); el.addEventListener('input',updateSurveyCascade); }
  });
  updateSurveyCascade();

  const role=AUTH.user?.role||'';
  const userProjs=(AUTH.user?.project||'').split(',').map(p=>p.trim()).filter(Boolean);
  const isRestricted=(role==='leader'||role==='inspector');
  if(isRestricted){
    if(!editId){
      if(userProjs.length===1) $('#sdlgProject').value=userProjs[0];
      $('#sdlgInspector').value=AUTH.user?.name||AUTH.user?.username||'';
    }
    $('#sdlgInspector').disabled=true; $('#sdlgInspector').style.background='#EEF1F4';
    if(userProjs.length===1){ $('#sdlgProject').disabled=true; $('#sdlgProject').style.background='#EEF1F4'; }
    else { $('#sdlgProject').disabled=false; $('#sdlgProject').style.background=''; }
  } else {
    $('#sdlgProject').disabled=false; $('#sdlgProject').style.background='';
    $('#sdlgInspector').disabled=false; $('#sdlgInspector').style.background='';
  }
  updateSurveyCascade();
  $('#surveyDialog').classList.add('open');
}
function closeSurveyDialog(){
  if(!editingSurveyId) saveSurveyDraft();
  $('#surveyDialog').classList.remove('open');
  editingSurveyId=null; surveyImgMain=''; surveyImgSticker='';
}

async function saveSurvey(){
  const g=id=>{const el=$('#'+id);return el?el.value.trim():'';};
  const project=g('sdlgProject'),equipment=g('sdlgEquip'),inspector=g('sdlgInspector');
  if(!project){toast('กรุณากรอกโครงการ',false);return;}
  if(!equipment){toast('กรุณากรอกอุปกรณ์',false);return;}
  if(!inspector){toast('กรุณากรอกชื่อผู้กรอก',false);return;}
  const btn=$('#sdlgSaveBtn'); btn.disabled=true; btn.textContent='กำลังบันทึก…';
  const record={
    id:editingSurveyId||uid(), project, system:g('sdlgSystem'),
    location:g('sdlgLoc'), sublocation:g('sdlgSub'), equipment,
    brand:g('sdlgBrand'), model:g('sdlgModel'), serial:g('sdlgSerial'),
    inspector, surveyDate:g('sdlgDate'), note:g('sdlgNote'),
    createdAt:editingSurveyId?(surveyCache.find(x=>x.id===editingSurveyId)?.createdAt||Date.now()):Date.now()
  };
  const images={
    main:surveyImgMain&&surveyImgMain.startsWith('data:')?surveyImgMain:'',
    sticker:surveyImgSticker&&surveyImgSticker.startsWith('data:')?surveyImgSticker:''
  };
  const action=editingSurveyId?'updateSurvey':'createSurvey';
  const r=await api(action,{record,images});
  btn.disabled=false; btn.textContent='💾 บันทึก';
  if(r&&r.ok){
    clearSurveyDraft();
    closeSurveyDialog();
    toast(editingSurveyId?'แก้ไขรายการแล้ว':'บันทึกรายการแล้ว',true);
    await loadSurvey();
  } else {
    saveSurveyDraft();
    toast((r&&r.message)||'บันทึกไม่สำเร็จ กรุณาลองใหม่',false);
  }
}

async function deleteSurveyEntry(id){
  if(!confirm('ลบรายการสำรวจนี้?'))return;
  const r=await api('deleteSurvey',{id});
  if(r&&r.ok){toast('ลบแล้ว',true);await loadSurvey();}
  else toast((r&&r.message)||'ลบไม่สำเร็จ',false);
}

