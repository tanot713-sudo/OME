let usersCache=[];
async function loadUsers(){if(!canSeeUsers())return;const r=await api(ACT.listUsers,{});if(r&&r.ok&&Array.isArray(r.users)){usersCache=r.users;renderUsers(r.users);}}
function renderUsers(list){list=list||usersCache;window._userList=list;const tb=$('#usersBody');if(!tb)return;tb.innerHTML=list.map(u=>`<tr><td><b>${esc(u.username)}</b></td><td class="codecell" style="font-size:12px">${u.username!=='admin'?(u.plainPwd?esc(u.plainPwd):'—'):'••••••••'}</td><td>${esc(u.name||'-')}</td><td><span class="role-badge role-${esc(u.role)}">${esc(u.role)}</span></td><td>${esc(u.project||'-')}</td><td><span class="status-dot ${u.active?'active':'inactive'}"></span>${u.active?'ใช้งาน':'ปิดแล้ว'}</td><td>${u.username!=='admin'?`<div class="rowact"><button class="icon-btn" onclick="openEditUser('${u.username}')">✎</button><button class="icon-btn del" onclick="deleteUser('${u.username}')">🗑</button></div>`:'—'}</td></tr>`).join('');}
let editUserTarget=null;
function openEditUser(username){const u=(window._userList||[]).find(x=>x.username===username);if(!u)return;editUserTarget=username;const np=prompt('รหัสผ่านใหม่ (เว้นว่างถ้าไม่เปลี่ยน)','');const role=prompt('สิทธิ์ (admin/manager/leader/inspector/observer)',u.role||'inspector');const project=prompt('โครงการ',u.project||'');saveEditUser(np,role,project);}
async function saveEditUser(password,role,project){const updates={role:role||'inspector',project:project||''};if(password&&password.trim())updates.password=password.trim();const r=await api('updateUser',{username:editUserTarget,updates});if(r&&r.ok){toast('แก้ไขผู้ใช้แล้ว',true);await loadUsers();}else toast((r&&r.message)||'แก้ไขไม่สำเร็จ',false);}
async function deleteUser(username){if(!confirm(`ลบผู้ใช้ "${username}"?`))return;const r=await api('deleteUser',{username});if(r&&r.ok){toast('ลบผู้ใช้แล้ว',true);await loadUsers();}else toast((r&&r.message)||'ลบไม่สำเร็จ',false);}
if($('#nuAdd'))$('#nuAdd').addEventListener('click',async()=>{const username=$('#nuUser').value.trim(),password=$('#nuPass').value.trim();if(!username||!password){toast('กรุณากรอก username และ password',false);return;}const r=await api(ACT.createUser,{username,password,name:$('#nuName').value.trim(),role:$('#nuRole').value,project:$('#nuProject').value.trim()});if(r&&r.ok){toast('เพิ่มผู้ใช้แล้ว',true);['nuUser','nuPass','nuName','nuProject'].forEach(id=>$('#'+id).value='');await loadUsers();}else toast((r&&r.message)||'เพิ่มผู้ใช้ไม่สำเร็จ',false);});
