// ดึงรูปผ่าน backend (UrlFetchApp) แทน fetch() ตรงจาก browser — เลี่ยงปัญหา CORS ของ drive.google.com
async function fetchImageBuffer(url){
  if(!url) return null;
  try{
    const m=String(url).match(/[-\w]{25,}/);
    if(m) url=`https://drive.google.com/thumbnail?id=${m[0]}&sz=w800`;
    const r=await api('fetchImageAsBase64',{url});
    if(!r||!r.ok||!r.base64) return null;
    const bin=atob(r.base64); const len=bin.length; const buf=new Uint8Array(len);
    for(let i=0;i<len;i++) buf[i]=bin.charCodeAt(i);
    return buf.buffer;
  }catch(e){ return null; }
}

