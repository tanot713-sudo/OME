  const name=prompt('ชื่อ Template (เช่น AMR_report_template_v2.docx)'); if(!name) return;
  const fileId=prompt('Drive File ID ของ Template (ต้องแชร์ให้บัญชีที่ deploy เข้าถึงได้)'); if(!fileId) return;
  const r=await api('saveReportTemplate',{name:name.trim(),fileId:fileId.trim()});
  if(r&&r.ok){ toast('เพิ่ม Template แล้ว',true); await loadReportTemplates(); }
  else toast((r&&r.message)||'เพิ่มไม่สำเร็จ',false);
});

/* ─── Report field presets — autocomplete จากค่าที่เคยกรอก ───────────────── */
async function loadReportPresets(){
  const r=await api('listReportPresets',{});
  if(!(r&&r.ok&&r.presets)) return;
  const map={contractName:'dl_wgContract',contractNo:'dl_wgContractNo',clause:'dl_wgClause',submittedTo:'dl_wgSubmittedTo',logoCustomer:'dl_wgLogoCustomer'};
  Object.keys(map).forEach(field=>{
    const dl=document.getElementById(map[field]); if(!dl) return;
    const vals=r.presets[field]||[];
    dl.innerHTML=vals.map(v=>`<option value="${escAttr(v)}">`).join('');
  });
}
document.querySelectorAll('.tab[data-tab="import"]').forEach(t=>t.addEventListener('click',()=>{ loadReportTemplates(); loadReportPresets(); }));

/* ─── รอ docx library โหลดเสร็จแล้วเปิดปุ่ม Generate ──────── */
(function waitForDocx(){
  const btn = document.getElementById('wgGenerate');
  if(!btn) return;
  let tries = 0;
  const check = setInterval(()=>{
    tries++;
    if(typeof docx !== 'undefined'){
      clearInterval(check);
      btn.disabled = false;
      btn.textContent = '⬇ สร้างและดาวน์โหลด Word (ในเบราว์เซอร์)';
    } else if(tries > 30){
      clearInterval(check);
      btn.disabled = false;
      btn.textContent = '⬇ สร้างและดาวน์โหลด Word (ลองใหม่)';
    }
  }, 500);
})();

