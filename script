  $('#authEye').addEventListener('click',()=>{const p=$('#authPass');const show=p.type==='password';p.type=show?'text':'password';$('#authEye').textContent=show?'ซ่อน':'แสดง';});
  $('#logoutBtn').addEventListener('click',()=>{if(confirm('ออกจากระบบ?'))doLogout();});
