function buildReport(){const logo=LOGO_SRC||'';let html=`<div class="rpt-runhead">${logo?`<img src="${logo}" alt="AMR">`:'<b style="color:#E2231A">AMR ASIA</b>'}<div class="ct">รายงานอุปกรณ์</div></div><div class="rpt-runfoot">รายงานผลการติดฉลากระบุรายละเอียดอุปกรณ์</div><div class="rpt-h1">รายงานอุปกรณ์</div>`;const projMap={};entries.forEach(e=>{const proj=e.project||'(ไม่ระบุ)';const loc=e.locName||'(ไม่ระบุ)';if(!projMap[proj])projMap[proj]={};(projMap[proj][loc]=projMap[proj][loc]||[]).push(e);});let n=0;Object.keys(projMap).sort().forEach((proj,pi)=>{html+=`<div class="rpt-proj-heading">${pi+1}. ${esc(proj)}</div>`;const locMap=projMap[proj];Object.keys(locMap).sort().forEach(loc=>{locMap[loc].forEach(e=>{n++;const main=e.thumbMain||e.imgMain||'',stk=e.thumbSticker||e.imgSticker||'';const hasImg=!!(main||stk);const cell=(url,cap)=>url?`<div class="cell"><img src="${url}"><div class="cap">${cap}</div></div>`:`<div class="cell empty"></div>`;html+=`<div class="rpt-equip${hasImg?'':' noimg'}"><div class="rpt-equip-title">${n}. ${esc(e.equipment||'(ไม่ระบุ)')}</div>${e.brand?`<div class="rpt-equip-line">ยี่ห้อ ${esc(e.brand)} รุ่น ${esc(e.model||'-')}</div>`:''}${e.serial?`<div class="rpt-equip-meta">Serial: ${esc(e.serial)}</div>`:''}<div class="rpt-equip-loc">${esc(loc)}${e.subName?' '+esc(e.subName):''}</div>${hasImg?`<div class="rpt-imgs">${cell(main,'รูปรวมอุปกรณ์')}${cell(stk,'รูปสติกเกอร์')}</div>`:''}${e.note?`<div class="rpt-note">หมายเหตุ: ${esc(e.note)}</div>`:''}</div>`;});});});$('#reportArea').innerHTML=html;const imgs=Array.from($('#reportArea').querySelectorAll('img'));if(!imgs.length){window.print();return;}let done=0,printed=false;const tryPrint=()=>{if(printed)return;printed=true;window.print();};const tick=()=>{done++;if(done>=imgs.length)tryPrint();};imgs.forEach(im=>{if(im.complete){tick();}else{im.addEventListener('load',tick);im.addEventListener('error',tick);}});setTimeout(tryPrint,8000);}

