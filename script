/* ─── รอ docx library โหลดเสร็จแล้วเปิดปุ่ม Generate ──────── */
(function waitForDocx(){
  const btn = document.getElementById('wgGenerate');
  if(!btn) return;
  let tries = 0;
  const check = setInterval(()=>{
    tries++;
    if(typeof docx !== 'undefined'){
      clearInterval(check);
      btn.disabled = false;
      btn.textContent = '⬇ สร้างและดาวน์โหลด Word (ในเบราว์เซอร์)';
    } else if(tries > 30){
      clearInterval(check);
      btn.disabled = false;
      btn.textContent = '⬇ สร้างและดาวน์โหลด Word (ลองใหม่)';
    }
  }, 500);
})();

