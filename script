function fillSurveyFilters(){
  const fp=$('#surveyFProject'),fs=$('#surveyFSystem'),fl=$('#surveyFLoc');
  if(!fp) return;
  const role=AUTH.user?.role||'', userProj=AUTH.user?.project||'';
  const isRestricted=role==='leader'||role==='inspector';
  if(isRestricted&&userProj){
    fp.innerHTML=`<option value="${escAttr(userProj)}">${esc(userProj)}</option>`;
    fp.value=userProj; fp.disabled=true; fp.style.background='#EEF1F4';
  } else {
    const projects=uniq(surveyCache.map(e=>e.project)).filter(Boolean).sort((a,b)=>a.localeCompare(b,'th'));
    const prev=fp.value;
    fp.innerHTML='<option value="">ทุกโครงการ</option>'+projects.map(p=>`<option value="${escAttr(p)}">${esc(p)}</option>`).join('');
    if(projects.includes(prev)) fp.value=prev; fp.disabled=false; fp.style.background='';
  }
  const fillDep=(el,src,key,defLabel)=>{
    if(!el) return;
    const prev=el.value;
    const vals=uniq(src.map(e=>e[key])).filter(Boolean).sort((a,b)=>a.localeCompare(b,'th'));
    el.innerHTML=`<option value="">${defLabel}</option>`+vals.map(v=>`<option value="${escAttr(v)}">${esc(v)}</option>`).join('');
    if(vals.includes(prev)) el.value=prev;
  };
  let sc=surveyCache; if(fp.value) sc=sc.filter(e=>e.project===fp.value);
  fillDep(fs,sc,'system','ทุกระบบ');
  let sc2=sc; if(fs&&fs.value) sc2=sc2.filter(e=>e.system===fs.value);
  fillDep(fl,sc2,'location','ทุกสถานที่');
  let sc3=sc2; if(fl&&fl.value) sc3=sc3.filter(e=>e.location===fl.value);
  fillDep($('#surveyFSub'),sc3,'sublocation','ทุกสถานที่ย่อย');
  let sc4=sc3; if($('#surveyFSub')&&$('#surveyFSub').value) sc4=sc4.filter(e=>e.sublocation===$('#surveyFSub').value);
  fillDep($('#surveyFEquip'),sc4,'equipment','ทุกอุปกรณ์');
}

function renderSurvey(){
  fillSurveyFilters();
  const q=($('#surveySearch')?$('#surveySearch').value:'').trim().toLowerCase();
  const fp=$('#surveyFProject')?$('#surveyFProject').value:'';
  const fs=$('#surveyFSystem')?$('#surveyFSystem').value:'';
  const fl=$('#surveyFLoc')?$('#surveyFLoc').value:'';
  const fsub=$('#surveyFSub')?$('#surveyFSub').value:'';
  const feq=$('#surveyFEquip')?$('#surveyFEquip').value:'';
  const sortV=$('#surveySort')?$('#surveySort').value:'newest';

  let list=surveyCache.filter(e=>!q||[e.project,e.system,e.location,e.sublocation,e.equipment,e.brand,e.model,e.serial,e.inspector,e.note].join(' ').toLowerCase().includes(q));
  if(fp)list=list.filter(e=>e.project===fp);
  if(fs)list=list.filter(e=>e.system===fs);
  if(fl)list=list.filter(e=>e.location===fl);
  if(fsub)list=list.filter(e=>e.sublocation===fsub);
  if(feq)list=list.filter(e=>e.equipment===feq);
  if(sortV==='newest') list.sort((a,b)=>b.createdAt-a.createdAt);
  else if(sortV==='oldest') list.sort((a,b)=>a.createdAt-b.createdAt);
  else if(sortV==='az') list.sort((a,b)=>(a.equipment||'').localeCompare(b.equipment||''));
  else if(sortV==='za') list.sort((a,b)=>(b.equipment||'').localeCompare(a.equipment||''));
  else if(sortV==='proj_th_az') list.sort((a,b)=>(a.project||'').localeCompare(b.project||'','th'));
  else if(sortV==='proj_th_za') list.sort((a,b)=>(b.project||'').localeCompare(a.project||'','th'));
  else if(sortV==='proj_en_az') list.sort((a,b)=>(a.project||'').localeCompare(b.project||'','en'));
